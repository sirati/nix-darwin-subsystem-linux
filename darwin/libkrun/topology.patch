 /// Type for returning public functions outcome.
 pub type Result<T> = result::Result<T, Error>;
 
+/// Two-cluster (big.LITTLE) CPU topology exposed to the guest.
+///
+/// vCPUs `0..big_cpus` form the big cluster, the rest the little cluster.
+/// The capacities are written to the FDT as `capacity-dmips-mhz`. The QoS
+/// values are raw macOS `qos_class_t` numbers applied to the vCPU threads
+/// (0 = leave unset); they are ignored on other hosts.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct CpuTopology {
+    pub big_cpus: u8,
+    pub big_capacity: u32,
+    pub little_capacity: u32,
+    pub big_qos: u32,
+    pub little_qos: u32,
+}
+
+impl CpuTopology {
+    pub fn is_big(&self, cpu_index: u8) -> bool {
+        cpu_index < self.big_cpus
+    }
+
+    pub fn capacity_for(&self, cpu_index: u8) -> u32 {
+        if self.is_big(cpu_index) {
+            self.big_capacity
+        } else {
+            self.little_capacity
+        }
+    }
+
+    pub fn qos_for(&self, cpu_index: u8) -> u32 {
+        if self.is_big(cpu_index) {
+            self.big_qos
+        } else {
+            self.little_qos
+        }
+    }
+}
