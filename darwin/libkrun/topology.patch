 #[allow(clippy::missing_safety_doc)]
 #[no_mangle]
+pub unsafe extern "C" fn krun_set_cpu_topology(
+    ctx_id: u32,
+    big_cpus: u8,
+    big_capacity: u32,
+    little_capacity: u32,
+    big_qos: u32,
+    little_qos: u32,
+) -> i32 {
+    if big_capacity == 0 || little_capacity == 0 {
+        return -libc::EINVAL;
+    }
+    match CTX_MAP.lock().unwrap().entry(ctx_id) {
+        Entry::Occupied(mut ctx_cfg) => {
+            let cfg = ctx_cfg.get_mut();
+            cfg.vmr.cpu_topology = Some(vmm::resources::CpuTopology {
+                big_cpus,
+                big_capacity,
+                little_capacity,
+                big_qos,
+                little_qos,
+            });
+            KRUN_SUCCESS
+        }
+        Entry::Vacant(_) => -libc::ENOENT,
+    }
+}
